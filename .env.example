# Config for the art-generation pipeline (gen_*.sh, generate_trains.sh,
# assets/tools/sd_client.js). Not needed to play the game itself - copy this
# to .env and `source .env` (or export the vars another way) only if you're
# regenerating sprite/tileset art.

# Your local Stable Diffusion (AUTOMATIC1111) API endpoint.
A1111_URL=http://127.0.0.1:7860

# Same value, read by assets/tools/sd_client.js (SD_API takes precedence
# over A1111_URL if both are set).
SD_API=http://127.0.0.1:7860
